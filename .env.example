# Apify API token. Required by search_kols to fetch TikTok and YouTube creators.
# Get one at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Jev API key. score_fit calls https://api.typesafe.ai/v1/systemone.
# draft_email only checks that this key is set. The email body is still a local English template.
JEV_API_KEY=

# Optional. Defaults to jev-latest.
# JEV_MODEL=jev-latest

# How many matching profiles to request from Apify per search.
# Unset, empty, or not a positive integer means 12.
# Every returned profile is stored locally. The search_kols limit only controls how many rows come back.
# FETCH_LIMIT=12
